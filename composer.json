{
    "name": "staxxer/oauth2-moneybird",
    "description": "Moneybird OAuth 2.0 Client Provider for The PHP League OAuth2-Client",
    "license": "MIT",
    "keywords": ["oauth", "oauth2", "client", "moneybird", "bookkeeping"],
    "require": {
        "php": "^7.1 || >=8.0 <8.6",
        "league/oauth2-client": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5.20 || ^8.5.21 || ^9.6 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Staxxer\\OAuth2\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Staxxer\\OAuth2\\Client\\Test\\": "test/"
        }
    }
}
